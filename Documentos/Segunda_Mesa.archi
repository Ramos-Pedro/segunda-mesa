<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Segunda Mesa - Arquitetura (TOGAF)" id="id-713a5e2d26024936b2bd24877f981ec0" version="4.9.0">
<purpose>Segunda Mesa: plataforma que da uma segunda chance ao alimento excedente do comercio (vender, doar, compostar). Global Solution CitizenTech - FIAP.</purpose>
<folder name="Strategy" id="id-183b79bf3fad45ba817f33541a8d0703" type="strategy"/>
<folder name="Business" id="id-4258c629a54946c4b623372c0a1b41ec" type="business">
<element xsi:type="archimate:BusinessActor" name="Loja / Restaurante" id="id-c4542eb8e5c7489eb9442f73f58fddc7"><documentation>Estabelecimento comercial que gera excedente.</documentation></element>
<element xsi:type="archimate:BusinessActor" name="Consumidor" id="id-8510c21e93414bd583690b810dd7b835"><documentation>Pessoa que compra lotes na fase F1.</documentation></element>
<element xsi:type="archimate:BusinessActor" name="ONG verificada" id="id-70bc58c94cc34a26bdc6355e92f357ba"><documentation>Organização verificada por CNPJ.</documentation></element>
<element xsi:type="archimate:BusinessActor" name="Pessoa elegível" id="id-cffdeb5549c24c1096090ee66c01182a"><documentation>Pessoa com ID Jovem ou Declaração de Hipossuficiência.</documentation></element>
<element xsi:type="archimate:BusinessActor" name="Operador de pátio de compostagem" id="id-2c8ca8a570a74c69889f04dec5f598b5"><documentation>Recebe o orgânico do destino final (F4).</documentation></element>
<element xsi:type="archimate:BusinessActor" name="Prefeitura / Poder público" id="id-15c2059c2e9d48b2be289d05a307c18a"><documentation>Consulta os indicadores de impacto.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Ofertante do excedente" id="id-e9bdd005235e4e828440167f2d6f37b6"><documentation>Cadastra o lote e entrega o item na retirada.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Comprador" id="id-6884bc3e0e254cb59719eef3bc827424"><documentation>Paga o lote na fase F1 e retira com o código.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Beneficiário institucional" id="id-449cecde64864e05ae4f533f416201db"><documentation>ONG que reserva e retira lotes gratuitos.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Validador de cadastro" id="id-7cc0f271e44f4cdebba971e27bd7daa0"><documentation>ONG que apoia o cadastro assistido de pessoas elegíveis.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Beneficiário individual" id="id-d7e5b14377e548e8af1300cc661cedf0"><documentation>Pessoa elegível ou qualquer pessoa (F3) que reserva e retira lotes gratuitos.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Receptor de destino final" id="id-880d5575f5e0404892da98c3a6b12995"><documentation>Recebe o lote não retirado para compostagem, ração ou biomassa.</documentation></element>
<element xsi:type="archimate:BusinessRole" name="Gestor público" id="id-554668c20c6b4a08b2285a417a440f0a"><documentation>Consulta o painel de impacto.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Gestão de Lotes" id="id-05e0a3afe5024f52bad3249fde5c2668"><documentation>Cadastro e publicação dos lotes de excedente.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Comercialização (F1)" id="id-f21916364f254e4cbd972ec9223bf5d5"><documentation>Venda do excedente com desconto.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Doação Priorizada (F2a, F2b, F3)" id="id-88ee43e2047a4e39955561e718a5d30b"><documentation>Doação com prioridade para ONGs, depois elegíveis, depois qualquer pessoa.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Retirada" id="id-44dde33319d54b98b584d5253bdb40b5"><documentation>Entrega do item a quem adquiriu ou reservou.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Destinação Final (F4)" id="id-2097d0016f1946e29e4d1bb94324ff51"><documentation>Compostagem, ração ou biomassa.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Verificação de Elegibilidade" id="id-34fcdd64107c4750bb8014005d8165a6"><documentation>Validação de ONGs e pessoas.</documentation></element>
<element xsi:type="archimate:BusinessFunction" name="Medição de Impacto" id="id-1190e3b2967c4ee896f6a751bf66f04f"><documentation>Indicadores de kg salvos e desvio do aterro.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Cadastrar lote" id="id-0180b01da9a546e8a2b0eb5c9184a5b0"><documentation>Evento de início: Excedente identificado pela loja. Evento de fim: Lote publicado. Papel: Ofertante. Local: Estabelecimento comercial.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Vender lote (F1)" id="id-acbb4b899f2f49f8bedd77e4d4c91d2e"><documentation>Evento de início: Lote publicado. Evento de fim: Lote vendido ou T-2h atingido sem venda. Papéis: Ofertante e Comprador.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Ofertar a ONGs (F2a)" id="id-8530c1c00c6046ecb96093ee45ca8469"><documentation>Evento de início: T-2h atingido sem venda. Evento de fim: T-1h15 atingido sem reserva (ou Reserva confirmada). Público: somente ONGs verificadas.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Ampliar a elegíveis (F2b)" id="id-b5b3d8bcd60e4b3db23d77b18c7bc5b9"><documentation>Evento de início: T-1h15 atingido sem reserva. Evento de fim: T-30min atingido sem reserva (ou Reserva confirmada). Público: ONGs e pessoas elegíveis.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Abrir doação (F3)" id="id-ed6ac674257c46338d03e9144731e799"><documentation>Evento de início: T-30min atingido sem reserva. Evento de fim: T atingido sem retirada (ou Reserva confirmada). Público: qualquer pessoa.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Reservar lote" id="id-155d633f319b4aa1a4b5c1fdf68e72b6"><documentation>Evento de início: oferta aberta (F2a, F2b ou F3). Evento de fim: Reserva confirmada (código de 4 dígitos). Papéis: Beneficiário institucional e individual.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Retirar lote com código" id="id-6c85035ebfdf401585d8eecff3555e59"><documentation>Evento de início: Lote vendido ou Reserva confirmada. Evento de fim: Lote retirado. Papéis: Ofertante, Comprador, Beneficiários.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Encaminhar destino final (F4)" id="id-215304ea5d614decb42c91d534e669d7"><documentation>Evento de início: T atingido sem retirada. Evento de fim: Destino final registrado. Papel: Receptor de destino final.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Verificar elegibilidade" id="id-da561673ff09484f842b09a1fc5ae12b"><documentation>Evento de início: Solicitação de cadastro recebida. Evento de fim: Elegibilidade validada. Papel: Validador de cadastro.</documentation></element>
<element xsi:type="archimate:BusinessProcess" name="Medir impacto" id="id-a693331be0304f5586731f5d77fb2882"><documentation>Evento de início: Lote retirado ou Destino final registrado. Evento de fim: Indicadores atualizados. Papel: Gestor público.</documentation></element>
<element xsi:type="archimate:BusinessEvent" name="Excedente identificado pela loja" id="id-859433f7224246cb806678f10c089d92"/>
<element xsi:type="archimate:BusinessEvent" name="Lote publicado" id="id-186e9a0ddfae42b4b8f52963ace6dd8d"/>
<element xsi:type="archimate:BusinessEvent" name="Lote vendido (pagamento confirmado)" id="id-da5b2d5a8d394b49b916a7a8977e92d7"/>
<element xsi:type="archimate:BusinessEvent" name="T-2h atingido sem venda" id="id-ef718525dd0d48c1a1215156b6aa52dc"/>
<element xsi:type="archimate:BusinessEvent" name="T-1h15 atingido sem reserva" id="id-8f2ab2af82184f78b00262cad7fca18a"/>
<element xsi:type="archimate:BusinessEvent" name="T-30min atingido sem reserva" id="id-c672ac3d219c4f84abfb82e62f336bee"/>
<element xsi:type="archimate:BusinessEvent" name="T atingido sem retirada" id="id-0e2affc6d23741c79b6bb9c34e1dede8"/>
<element xsi:type="archimate:BusinessEvent" name="Reserva confirmada" id="id-d90c5cb1debb4deb90443c1faa9917ac"/>
<element xsi:type="archimate:BusinessEvent" name="Lote retirado" id="id-4df402963497499493b35f8e5cb6e220"/>
<element xsi:type="archimate:BusinessEvent" name="Destino final registrado" id="id-1d7126c43d06457398dc3dc7c48b01be"/>
<element xsi:type="archimate:BusinessEvent" name="Solicitação de cadastro recebida" id="id-7c500d72b5654de5a9c34a25e1e096ae"/>
<element xsi:type="archimate:BusinessEvent" name="Elegibilidade validada" id="id-a984bef3873943dc9cbfb7d18b85eec4"/>
<element xsi:type="archimate:BusinessEvent" name="Indicadores atualizados" id="id-d9ad437956414eb59e593ad011b9c16e"/>
</folder>
<folder name="Application" id="id-3f3b41dd02854605913f855baa32bffa" type="application">
<element xsi:type="archimate:ApplicationComponent" name="Front-end Web Responsivo" id="id-23b1d6e7b7054072b4a188f9da499324"><documentation>Camada de Apresentação (acesso) para lojas, ONGs e pessoas.
Padrão de interface: web responsivo, mobile-first; fluxo curto, botões grandes e linguagem simples; botões de horário de chegada (15, 30 ou 60 min); retirada por código de 4 dígitos; cadastro assistido pela ONG.
Telas do MVP: Cadastro do lote, Ofertas por fase, Reserva e código, Painel de impacto.</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Bot WhatsApp / Telegram (roadmap)" id="id-2af0a07fc4fc4ebb9284888e2918dd80"><documentation>Canal principal para o público de baixo letramento digital. Respostas simples (1 = sim, 2 = não). Fora do MVP.</documentation><property key="Fase" value="Roadmap"/></element>
<element xsi:type="archimate:ApplicationComponent" name="API Segunda Mesa (Java Spring Boot)" id="id-63c4adf6c9694161bf12273031f4d89f"><documentation>Camada de Aplicação: regras de negócio expostas por API REST (JSON sobre HTTPS).</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Módulo de Lotes" id="id-e28a9ec4e97b4748b9b0a51492359aae"><documentation>Cadastro e consulta de lotes (RF01).</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Motor da Cascata (@Scheduled)" id="id-cb9ab09e73da426180af27e99fe5d2aa"><documentation>Job que dispara as transições em T-2h, T-1h15, T-30min e T e expira reservas (RF02, RF08).</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Módulo de Reservas e Retirada" id="id-cf6123662b5e4b94b1a2de39fedb6094"><documentation>Reservas com horário de chegada, código de 4 dígitos e retirada (RF04, RF06).</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Módulo de Elegibilidade" id="id-eb48607dc4d5423497f9d673499829e1"><documentation>Verificação de ONGs (CNPJ) e pessoas (ID Jovem ou Declaração de Hipossuficiência) (RF05).</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Módulo de Pagamento (PIX simulado)" id="id-14b7e681427e471e9325b0e67d5a8a0b"><documentation>Compra na fase F1 (RF03). PIX real no roadmap.</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Módulo de Impacto e Painel" id="id-2ed151ca6a114fca8cacaa907c39d0a6"><documentation>Indicadores de kg salvos, % desviado do aterro e CO2 evitado (RF07).</documentation></element>
<element xsi:type="archimate:ApplicationInterface" name="API REST (JSON / HTTPS)" id="id-86ea1d357b5a4f34914e727fee2d8b3b"><documentation>Padrão de troca de dados entre Apresentação e Aplicação: recursos REST com payload JSON sobre HTTPS.</documentation></element>
<element xsi:type="archimate:ApplicationComponent" name="Persistência (Spring Data JPA)" id="id-3ea9343d6eb84313af51226d98956c26"><documentation>Camada de Dados: mapeia objetos de domínio para tabelas relacionais.</documentation></element>
<element xsi:type="archimate:DataObject" name="LOTE" id="id-07005f6cb5c5417eb7adb7c73e0afdff"><documentation>Lote de excedente: descrição, categoria, kg, preço, prazo T e fase atual.</documentation></element>
<element xsi:type="archimate:DataObject" name="RESERVA" id="id-30212db30329453286801f45aaf645f3"><documentation>Reserva: lote, beneficiário, horário de chegada, código de 4 dígitos, status.</documentation></element>
<element xsi:type="archimate:DataObject" name="PEDIDO_VENDA" id="id-0a56c3226f554f90b106c76e61843dc7"><documentation>Pedido de venda da fase F1 e pagamento PIX simulado.</documentation></element>
<element xsi:type="archimate:DataObject" name="OFERTA_DOACAO" id="id-2c92e6fcc2954e4084cb455f32786712"><documentation>Oferta de doação do lote nas fases F2a, F2b e F3.</documentation></element>
<element xsi:type="archimate:DataObject" name="ELEGIBILIDADE" id="id-95b8ca9acdaf4ba98183f93ab2d352d8"><documentation>Somente status, tipo, validade e validador (LGPD).</documentation></element>
<element xsi:type="archimate:DataObject" name="MOVIMENTACAO_LOTE" id="id-74d34e53100243c6b3c1911bd5513eb0"><documentation>Auditoria: fase, destinatário e termo de ciência de cada mudança de fase.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Cadastro de Lotes" id="id-e189bb75d21e4689ace3a9f48534a796"><documentation>Publica lotes com preço e prazo T.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Roteamento da Cascata" id="id-cccda2d14f2948ce961659eda2406c6c"><documentation>Move cada lote pelas fases F1 a F4.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Pagamento" id="id-075c61dfc63f453e9c5d988dc1a0084e"><documentation>Cobrança por PIX simulado.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Reserva e Retirada" id="id-3fb501d7c5fb449b8d271554775b3c2d"><documentation>Reserva, código de 4 dígitos e baixa.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Verificação de Elegibilidade" id="id-c8871bee94a2446d9aad31b72a3750c3"><documentation>Valida ONGs e pessoas.</documentation></element>
<element xsi:type="archimate:ApplicationService" name="Serviço de Painel de Impacto" id="id-36daf56b1f874ecf975e6a08897bc2e1"><documentation>Consolida indicadores.</documentation></element>
</folder>
<folder name="Technology &amp; Physical" id="id-bf008fd87b6848a792b19fd42115dfc5" type="technology">
<element xsi:type="archimate:SystemSoftware" name="SGBD Relacional (Oracle ou PostgreSQL)" id="id-d046a4afc8624a3a929032aa284da23d"><documentation>Armazena LOTE, RESERVA, PEDIDO_VENDA, OFERTA_DOACAO, ELEGIBILIDADE e MOVIMENTACAO_LOTE. Acesso por SQL via JDBC.</documentation></element>
</folder>
<folder name="Motivation" id="id-3fe70108012e4ad58b1e4a300d91ad22" type="motivation">
<element xsi:type="archimate:Stakeholder" name="Lojas e Restaurantes" id="id-bbf87ac0981146a6acbf8e7e89bb09d4"><documentation>Doadores e vendedores do excedente. Interesse: recuperar parte do custo do excedente e reduzir o descarte com pouco esforço operacional.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="ONGs verificadas" id="id-e8d9c7dae9854d1d9203b58ccdd9835a"><documentation>Interesse: receber alimento gratuito, com prioridade até a fase F3, e fazer o cadastro assistido de pessoas elegíveis.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Pessoas elegíveis" id="id-118994a3d53a4f668a1713d683685a23"><documentation>Pessoas em insegurança alimentar (ID Jovem ou Declaração de Hipossuficiência). Interesse: acessar comida gratuita por canal simples (WhatsApp, código de 4 dígitos).</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Consumidores" id="id-7bb04e15239a47708b32e10c4da4c75b"><documentation>Interesse: comprar alimento do dia com até 70% de desconto na fase F1.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Prefeitura / Poder público" id="id-ef8e5f6fc2f443689734b6164e2318e8"><documentation>Interesse: menos orgânico no aterro e dados de impacto para políticas públicas; possível pagamento por resultado (kg resgatado).</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Operadores de pátios de compostagem" id="id-0cbb9fa48a2c4713bf1123586befae9a"><documentation>Interesse: receber orgânico segregado (5 pátios municipais de São Paulo; piloto no pátio da Lapa).</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Vigilância Sanitária e nutricionistas" id="id-979fe8681efe44e58256c28f1b678789"><documentation>Interesse: segurança sanitária das doações (art. 14 da Lei 15.224/2025).</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Equipe do projeto" id="id-78d81bf88c7b428ca948fe3b433e92b1"><documentation>Pedro Ribeiro Ramos (RM 559513) e Thiago C. Mendes Machado (RM 560032). Interesse: entregar o MVP da Segunda Mesa.</documentation></element>
<element xsi:type="archimate:Driver" name="Desperdício de alimentos no comércio" id="id-c41402ae315f4e338233a60405d2315d"><documentation>Estimativas de 26,3 a 46 milhões de t/ano no Brasil; R$ 61,3 bi/ano de prejuízo (Food to Save/IBGE). CEAGESP descarta ~150 t/dia.</documentation></element>
<element xsi:type="archimate:Driver" name="Insegurança alimentar" id="id-4a57769aa53c497ca45e9bdae14d97e1"><documentation>Comida sobra no comércio enquanto falta na mesa.</documentation></element>
<element xsi:type="archimate:Driver" name="Orgânicos indo para aterros" id="id-a0ccc45c8d14416cb7750f1d7e7acde7"><documentation>Apenas 1,6% dos resíduos orgânicos coletados são compostados; São Paulo envia ~5.700 t/dia de orgânicos aos aterros (Composta SP).</documentation></element>
<element xsi:type="archimate:Driver" name="Lei 15.224/2025 (PNCPDA)" id="id-736a37797e324799a2b99258733ad55c"><documentation>Ordem de prioridade: consumo humano, animal, compostagem/biomassa. Responsabilidade só por dolo (arts. 15-17). Microcoleta por apps é princípio (art. 4º, VIII).</documentation></element>
<element xsi:type="archimate:Driver" name="Baixo letramento digital do público final" id="id-b382c72f93224dfaac4536f92369759c"><documentation>65% dos usuários de internet usam só o celular; 87% nas classes D/E (TIC Domicílios 2025). WhatsApp é o canal principal.</documentation></element>
<element xsi:type="archimate:Driver" name="Necessidade de recuperar custo do excedente" id="id-7171f1c452b04ec7b6e6782f278b7c23"><documentation>Lojas buscam receita extra e menor custo de descarte.</documentation></element>
<element xsi:type="archimate:Driver" name="Demanda por dados de impacto" id="id-d337c72fec8b4bba8832fc3695edad8a"><documentation>O poder público precisa de indicadores de desvio do aterro para políticas públicas.</documentation></element>
<element xsi:type="archimate:Goal" name="Dar destino útil a todo alimento excedente" id="id-c67567dc080f491cb45467294ff0f070"><documentation>Vender, doar e compostar, na ordem certa.</documentation></element>
<element xsi:type="archimate:Goal" name="Recuperar parte do custo das lojas" id="id-e8d9411d7f364e9896b245793576e0bc"><documentation>Receita na fase de venda (F1) e menor descarte.</documentation></element>
<element xsi:type="archimate:Goal" name="Garantir alimento gratuito a ONGs e pessoas elegíveis" id="id-7aee87cdcda24b159055823635e13acd"><documentation>Prioridade para ONGs até a fase F3.</documentation></element>
<element xsi:type="archimate:Goal" name="Reduzir orgânico enviado ao aterro" id="id-54d70770be3142229b82178c025888c8"><documentation>Encaminhar o não retirado para compostagem, ração ou biomassa.</documentation></element>
<element xsi:type="archimate:Goal" name="Gerar dados de impacto para políticas públicas" id="id-91ef92e42eab4f34ad9542b623fb28d4"><documentation>Painel de kg salvos por destino e % do lote desviado do aterro.</documentation></element>
<element xsi:type="archimate:Goal" name="Incluir público com baixo letramento digital" id="id-89f885903d894d7d93a14658270bb80c"><documentation>WhatsApp, cadastro assistido, código de 4 dígitos e botões de horário.</documentation></element>
<element xsi:type="archimate:Principle" name="Cascata de recuperação: vender, doar, compostar" id="id-36ea7a8743294d4c8ef53ef1ce2f0773"><documentation>Cada lote desce a cascata (F1 a F4) até achar um destino, respeitando a ordem de prioridade da Lei 15.224/2025.</documentation></element>
<element xsi:type="archimate:Requirement" name="RF01 Cadastrar lote" id="id-2ad7dee6f2604462933a399fc76f8c15"><documentation>Ator: Lojista.
Regras:
1. Somente lojas e restaurantes cadastrados publicam lotes.
2. O lote informa descrição, categoria (consumo humano ou orgânico), quantidade em kg, preço e prazo T (horário limite de retirada).
3. MVP: apenas itens do mesmo dia; T deve estar no mesmo dia da publicação.
4. O preço de venda (F1) é definido pela loja, com desconto de até 70%.
5. Os tempos de corte (T-2h, T-1h15, T-30min) são configuráveis.
6. Ao publicar, o lote entra na fase F1 e a publicação é registrada em MOVIMENTACAO_LOTE.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF02 Motor da cascata" id="id-3038954a8c70486b8b806e6059326180"><documentation>Regras:
1. F1 Venda: da publicação até T-2h.
2. F2a ONGs: de T-2h a T-1h15; somente ONGs verificadas; gratuito.
3. F2b Elegíveis: de T-1h15 a T-30min; ONGs e pessoas elegíveis; gratuito.
4. F3 Aberta: de T-30min a T; qualquer pessoa; gratuito.
5. F4 Destino: após T; lote não retirado vai para compostagem, ração ou biomassa.
6. Lote vendido ou retirado deixa de avançar na cascata.
7. Toda mudança de fase é registrada em MOVIMENTACAO_LOTE (fase, destinatário, data/hora).
8. Um job @Scheduled dispara as transições nos horários configurados.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF03 Comprar lote (F1)" id="id-575a728d57a443ff82323e5d43aba64c"><documentation>Regras:
1. A compra só é permitida na fase F1.
2. Pagamento por PIX simulado no MVP (PIX real no roadmap).
3. Pagamento confirmado bloqueia o lote para o comprador e gera código de retirada de 4 dígitos.
4. A venda segue o CDC; a doação não é relação de consumo (Lei 15.224/2025).
5. A coleta é responsabilidade de quem adquire o item.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF04 Reservar lote doado" id="id-9afbc5b6407a46fbb50edcfecc48adee"><documentation>Regras:
1. Reserva permitida apenas em F2a, F2b e F3, conforme o público da fase: F2a somente ONG verificada; F2b ONG ou pessoa elegível; F3 qualquer pessoa.
2. Reserva = bloqueio do lote com horário de chegada (15, 30 ou 60 min), confirmado por código de 4 dígitos.
3. A reserva expira no horário de chegada mais a tolerância, ou em T, o que ocorrer primeiro; o lote volta à oferta da fase vigente.
4. Faltas repetidas de retirada levam a uma pausa curta no cadastro.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF05 Verificar elegibilidade" id="id-89702dfc4bf147a5a0fbe82ccdad80b6"><documentation>Regras:
1. ONG é verificada por CNPJ.
2. Pessoa elegível comprova por ID Jovem ou Declaração de Hipossuficiência (Lei 7.115/1983).
3. O cadastro pode ser assistido por uma ONG (validador).
4. Guardar somente status, tipo, validade e validador da elegibilidade (LGPD).
5. Elegibilidade vencida impede reserva na fase F2b.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF06 Retirar com código" id="id-faa11b9081614af0b0ce73bfa4d8adeb"><documentation>Regras:
1. A retirada é confirmada na loja pelo código de 4 dígitos.
2. Código inválido ou reserva expirada impede a retirada.
3. Lote retirado é encerrado e o destino é registrado em MOVIMENTACAO_LOTE.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF07 Painel de impacto" id="id-0c222f3899a24a4a97953ae506861595"><documentation>Regras:
1. Exibir kg salvos por destino (venda, doação, compostagem, ração).
2. Exibir % do lote desviado do aterro, tempo até a retirada e taxa de não retirada.
3. CO2 evitado = kg x 2,5 (fator de referência da Food to Save).
4. A origem dos dados é MOVIMENTACAO_LOTE.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RF08 Encaminhar destino final (F4)" id="id-405ae77042b745b49f1efd860ecdb8f0"><documentation>Regras:
1. Após T, lotes não retirados são encaminhados a compostagem (pátios municipais; piloto no pátio da Lapa), ração animal (regras a validar) ou biomassa (roadmap).
2. O destino é registrado em MOVIMENTACAO_LOTE com o termo de ciência do destinatário.
3. Nenhum lote termina sem destino registrado.</documentation><property key="Tipo" value="Funcional"/></element>
<element xsi:type="archimate:Requirement" name="RNF01 LGPD" id="id-37b03fefbe0848cfbc86ed07fdee7b1c"><documentation>Guardar apenas status, tipo, validade e validador da elegibilidade; não armazenar documentos do público final.</documentation><property key="Tipo" value="Não funcional"/></element>
<element xsi:type="archimate:Requirement" name="RNF02 Pontualidade" id="id-9197f35b4e894231ab6d511abdbff56d"><documentation>As transições de fase ocorrem no horário configurado (job @Scheduled com verificação frequente).</documentation><property key="Tipo" value="Não funcional"/></element>
<element xsi:type="archimate:Requirement" name="RNF03 Auditoria" id="id-10e2681f74f44067bf91eb8424905440"><documentation>Toda mudança de fase fica registrada em MOVIMENTACAO_LOTE.</documentation><property key="Tipo" value="Não funcional"/></element>
<element xsi:type="archimate:Requirement" name="RNF04 Usabilidade" id="id-5bf63dbe4b7146c384dd414a789354a7"><documentation>Fluxo curto, botões grandes e linguagem simples. Teste de usabilidade com cerca de 5 pessoas.</documentation><property key="Tipo" value="Não funcional"/></element>
<element xsi:type="archimate:Requirement" name="RNF05 Testabilidade" id="id-8427aabd2f82454aa330112b72293972"><documentation>Testes automatizados das regras de roteamento da cascata.</documentation><property key="Tipo" value="Não funcional"/></element>
<element xsi:type="archimate:Constraint" name="Doação direta exige atestado de profissional habilitado" id="id-4afc0025d97e453ebe77b14dcb252168"><documentation>Art. 14 da Lei 15.224/2025: qualidade atestada 'na forma de regulamento'. Não há regulamento federal localizado: risco para a fase F3.</documentation></element>
<element xsi:type="archimate:Constraint" name="MVP: apenas itens do mesmo dia" id="id-0a4b8524235f4a3384a6787129ebeb86"><documentation>O MVP não trata estoque de mais de um dia.</documentation></element>
<element xsi:type="archimate:Constraint" name="Pagamento PIX simulado no MVP" id="id-1e855f85b5344f549f3fa9cf4b6f02a9"><documentation>PIX real fica no roadmap.</documentation></element>
<element xsi:type="archimate:Constraint" name="Venda segue o CDC; doação não é relação de consumo" id="id-40fa627b58a745fab21087cd94dfd8e2"><documentation>Arts. 15-17 da Lei 15.224/2025: doador e intermediário respondem só por dolo.</documentation></element>
<element xsi:type="archimate:Constraint" name="Regras de ração animal a validar no Brasil" id="id-b4b2f3af185842d59357bae00e99ab03"><documentation>No Japão a ração reciclada custa cerca de metade do preço; no Brasil as regras precisam ser validadas.</documentation></element>
</folder>
<folder name="Implementation &amp; Migration" id="id-fe830a2a3f274dad84398f5a41480ad3" type="implementation_migration"/>
<folder name="Other" id="id-1207eb5a564549b6afd2555bed27f6b2" type="other">
<element xsi:type="archimate:Location" name="Estabelecimento comercial" id="id-9ccd6c39e6904a7fb41ca8f8a54d4198"><documentation>Local de publicação e retirada dos lotes. Piloto: CEAGESP Vila Leopoldina (endereço a confirmar).</documentation></element>
<element xsi:type="archimate:Location" name="Ambiente digital (web e WhatsApp)" id="id-a5394992a9c84db6bd621b774fff06f1"><documentation>Canal de acesso do consumidor.</documentation></element>
<element xsi:type="archimate:Location" name="Sede da ONG" id="id-c6889ba9b0e942e1b0f84e1e888911e8"><documentation>Local de cadastro assistido e de operação da ONG.</documentation></element>
<element xsi:type="archimate:Location" name="Domicílio da pessoa ou CRAS" id="id-b3322075cf5f4ddfa8f593756a68f25a"><documentation>Local de acesso da pessoa elegível.</documentation></element>
<element xsi:type="archimate:Location" name="Pátio de compostagem" id="id-24109198e53a46fb93deed6b9db6924f"><documentation>Piloto: pátio da Lapa (endereço a confirmar).</documentation></element>
<element xsi:type="archimate:Location" name="Órgão público" id="id-2fa3135ea8ab483da7edb88077566adc"><documentation>Local de uso do painel pelo poder público.</documentation></element>
</folder>
